# Copy this file to .env and fill in your own values.
# Do not commit .env or share your private key.

KALSHI_API_KEY_ID=replace_with_your_key_id
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/your/kalshi-private-key.pem
KALSHI_ENV=production

# Each computer keeps its own local database by default.
KALSHI_DB_PATH=data/kalshi.db
